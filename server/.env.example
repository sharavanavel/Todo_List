# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to git.

# MongoDB Atlas connection string (see DEPLOYMENT.md, Part 1).
# Replace <username>, <password> and <cluster>. Note the database name "taskmanager" before the "?".
MONGO_URI=mongodb+srv://hello_31:Vel123@cluster0.bg9berl.mongodb.net/?appName=Cluster0

# Port the API listens on (Render/Railway set this automatically).
PORT=5001

# Only needed if the frontend is hosted on a DIFFERENT domain than the API
# (e.g. frontend on Vercel, API on Render). Leave empty for local dev
# or when the API serves the frontend itself.
CLIENT_ORIGIN=
